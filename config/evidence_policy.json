  "financing_codebook": {
    "version": "project-disclosed-finance-milestone-candidate-v1",
    "status": "EXPLORATORY_NOT_FORMAL_C1_NOT_EXPERT_VALIDATED",
    "states": {
      "EXPLICIT_NO_FINANCING": 0,
      "PLANNED_OR_NONBINDING": 1,
      "CONDITIONAL_COMMITMENT": 2,
      "FINANCIAL_CLOSE": 3,
      "DRAWN": 4
    },
    "interpretation": "Highest disclosed project-attributed financing milestone, not percentage funded, financial viability, probability or available cash. Conditional credit approval and conditional signed facilities both map to 2 but retain agreement_state separately. No comparison of monetary amounts.",
    "temporal_rule": "Latest within facility_id only; distinct facilities remain separate. Use explicit expiry/termination if disclosed. Undisclosed expiry remains unknown; a dated milestone never certifies current availability.",
    "aggregation": "At least one qualifying project instrument at milestone; 3 requires full project financial close; 4 requires documented drawdown. Explicit no-financing vs positive commitment conflict blocks scoring. CAPEX/offtake/corporate cash never establishes financing."
  },
  "technical_definitions": {
    "version": "technical-taxonomy-v1",
    "legacy_T1": "PROCESSING_COMPLEXITY_IN_UPSTREAM_RESEARCH_NOT_EQUIVALENT_TO_RECOVERY",
    "v2_T1": "RECOVERY_ONLY; explicit comparable feed/REO basis/endpoint/scale required",
    "T1_contract_status": "CONSERVATIVE_EXPLORATORY_COMPATIBILITY_CONTRACT_NOT_APPROVED_FORMAL_PANEL",
    "processing_complexity": {
      "status": "DESCRIPTIVE_ONLY_NO_ORDINAL_OR_SCIENTIFIC_ORDER_ADOPTED",
      "reason": "Number of operations cannot establish process difficulty; cost, energy, reagent intensity, mineral liberation and NORM handling differ. Preserve flowsheet text, endpoints and mineralogy. No substitution for recovery."
    },
    "endpoint_alternative": {
      "criterion": "TC1",
      "status": "EXPLORATORY_NOT_REPLACEMENT_FOR_T1",
      "definition": "Whole ore TREO-including-Y recovery to mineral concentrate, DFS model only",
      "scientific_basis": "Mass fraction of feed TREO reporting to a defined first-stage mineral concentrate; excludes leach solution, selected-composite assays, MREC and separated oxides",
      "limitations": "Engineering forecast, not measured operating recovery; different mine plans; downstream losses and impurity burden not assessed",
      "development_overlap": "Numeric recovery and study-stage are different variables, but DFS-only eligibility conditions on maturity. Compare only within this maturity; do not claim independent maturity effect."
    }
  },
