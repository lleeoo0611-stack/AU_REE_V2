  "technical_profile": {
    "version": "technical-profile-remediation-v2",
    "decision": "PROCESS_SPECIFIC_NUMERIC_MCDA_PLUS_NOMINAL_REQUIREMENTS",
    "status": "EXPLORATORY_NOT_INDEPENDENT_EXPERT_VALIDATED",
    "common_score": false,
    "ordinal_numeric_mapping": null,
    "technical_weight_change": 0,
    "states": [
      "SUPPORTED_LOWER_BURDEN",
      "EXPLICIT_ADDITIONAL_REQUIREMENT",
      "OBSERVED_MAJOR_OBSTACLE",
      "UNKNOWN",
      "CONFLICT",
      "NOT_APPLICABLE"
    ],
    "rules": [
      {
        "id": "TA-REAGENT",
        "criterion": "T-A",
        "pattern": "(?:acid|reagent|energy|power).{0,60}(?:consumption|requirement|demand)|(?:consumption|requirement).{0,60}(?:acid|reagent|energy)",
        "state": "EXPLICIT_ADDITIONAL_REQUIREMENT",
        "meaning": "A disclosed extraction input requirement, not a calibrated magnitude or cross-project difficulty order"
      },
      {
        "id": "TA-OBSTACLE",
        "criterion": "T-A",
        "pattern": "(?:observed|testwork|tests? (?:showed|demonstrated|confirmed)).{0,80}(?:refractory|poor extraction|failed to leach)",
        "state": "OBSERVED_MAJOR_OBSTACLE",
        "meaning": "Explicit observed extraction limitation at source scope"
      },
      {
        "id": "TA-LOWER",
        "criterion": "T-A",
        "pattern": "(?:tests? (?:showed|demonstrated|confirmed)|testwork demonstrated).{0,80}(?:no grinding required|negligible gangue dissolution)",
        "state": "SUPPORTED_LOWER_BURDEN",
        "meaning": "Positive test evidence for the named barrier only, never entire process burden"
      },
      {
        "id": "TB-TREATMENT",
        "criterion": "T-B",
        "pattern": "(?:impurit(?:y|ies)|thorium|uranium|residue|tailings).{0,90}(?:removal|neutralisation|neutralization|treatment|stabili[sz]ation|disposal)|(?:removal|neutralisation|neutralization).{0,60}(?:impurit(?:y|ies)|thorium|uranium)",
        "state": "EXPLICIT_ADDITIONAL_REQUIREMENT",
        "meaning": "Disclosed impurity or residue management requirement, not dose or risk inferred from ore concentration"
      },
      {
        "id": "TB-OBSTACLE",
        "criterion": "T-B",
        "pattern": "(?:tests? (?:showed|demonstrated|confirmed)|observed).{0,80}(?:failed.{0,25}(?:specification|impurity)|unacceptable impurit)",
        "state": "OBSERVED_MAJOR_OBSTACLE",
        "meaning": "Explicit test failure against named impurity or product specification"
      }
    ],
    "conflict_rule": "Different applicable states for the same scoped criterion remain a state set; no best/latest priority",
    "missing_rule": "No match means UNKNOWN, never lower burden. N/A requires explicit source applicability, not absence.",
    "scope_rule": "Source-case interpretation only; Project extrapolation requires independently supported target population coverage, not an issuer representative assertion",
    "negation_rule": "Negated, hypothetical and forward-looking matches do not establish observed performance",
    "double_counting": "Extraction inputs belong to T-A; distinct resulting residue treatment belongs to T-B. No aggregation into weighted score; Development remains separate.",
    "examples": {
      "positive": [
        "Tests demonstrated no grinding required.",
        "Acid consumption was measured on the selected composites.",
        "Impurity removal required neutralisation."
      ],
      "negative": [
        "A DFS was completed.",
        "The deposit is clay hosted.",
        "Ore contains 20 ppm thorium.",
        "The company uses proven technology.",
        "No acid consumption data were disclosed."
      ]
