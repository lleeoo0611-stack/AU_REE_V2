          <xsd:element maxOccurs="1" minOccurs="0" name="prod_comm" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="prod" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="prod_units" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="ore" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="ore_units" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="gold_p_gms" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="gold_ore_t" nillable="true" type="xsd:int"/>
