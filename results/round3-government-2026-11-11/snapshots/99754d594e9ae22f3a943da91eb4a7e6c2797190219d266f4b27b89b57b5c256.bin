          <xsd:element maxOccurs="1" minOccurs="0" name="ref_ids" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="plan_nos" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="miningmeth" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="project" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="rot_angle" nillable="true" type="xsd:short"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="plottype" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="audintrend" nillable="true" type="xsd:int"/>
