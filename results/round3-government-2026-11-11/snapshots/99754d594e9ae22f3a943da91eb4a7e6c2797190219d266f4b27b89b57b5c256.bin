          <xsd:element maxOccurs="1" minOccurs="0" name="mine_size" nillable="true" type="xsd:double"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="size_cat" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="ore_d" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="ore_dd" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="depth" nillable="true" type="xsd:double"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="minedleng" nillable="true" type="xsd:double"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="adit" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="in_situ" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="open_cut" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="shaft" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="decline" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="sluicing" nillable="true" type="xsd:string"/>
