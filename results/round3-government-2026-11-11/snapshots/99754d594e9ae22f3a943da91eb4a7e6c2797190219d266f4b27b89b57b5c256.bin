          <xsd:element maxOccurs="1" minOccurs="0" name="elev_gl" nillable="true" type="xsd:double"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="elev_acc" nillable="true" type="xsd:short"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="elev_meth" nillable="true" type="xsd:string"/>
