1","metal_no":"TH0180","old_no":"TH0180","metal_dist":"Nundle","all_names":"Stannings Antimony Mine","latgda94":-31.45936,"longda94":151.139253,"ll_coordsys":"GDA94","loc_method":"250K","accuracy":250,"grid_loc":null,"mga_north":6517989,"mga_east":323205,"mga_coordsys":"MGA_56S","length":null,"width":null,"depth":24,"dep_dip_plunge":null,"dep_dip_dir":70,"strike":160,"work_desc":"Shafts,","dep_shape":null,"structure":"shear","host_relate":null,"msn_style":"vein","ore_texture":null,"alteration":null,"placer":null,"spec_model":"vein","gen_model":"hydrothermal","cox_class":null,"other_class":"metahydrothermal - Sb (quartz vein)","nsw_class":"Structurally controlled Sb-Au","nsw_gen":"Hydrothermal metamorphic Au","summary_desc":"A major fault is shown to pass through the mine, on the 1:250,000 sheet.The lenses are at least 20 mm wide (Gilligan and Brownlow 1987).","size_code":"SML","major_comm":"Sb","minor_comm":null,"ore_min":"stibnite","gangue_min":"host, quartz","hostrocks":null,"reference":"Gilligan L.B. & Brownlow J.W. (1987) ;  Gilligan L.B., Brownlow J.W. & Cameron R.G. (1987) ","compiler":"CR Weber, May 1978","production":":12t actual production for  8.5t Sb  ","resources":null,"gs_number":null,"colour":"red","is_metmin_resource":"n"},"bbox":[151.1393,-31.4594,151.1393,-31.4594]},{"type":"Feature","id":"mineral_occurrence.151644","geometry":{"type":"Point","coordinates":[151.1464,-31.4712]},"geometry_name":"geom","properties":{"occurrence_id":151644,"deposit_name":"Woodleys Antimony Mine","comm_type":"METMIN","field_no":"ND0012","metal_no":"TH0181","old_no":"TH0181","metal_dist":"Nundle","all_names":"Woodleys Antimony Mine","latgda94":-31.47119,"longda94":151.146386,"ll_coordsys":"GDA94","loc_method":"250K","accuracy":250,"grid_loc":null,"mga_north":6516689,"mga_east":323905,"mga_coordsys":"MGA_56S","length":100,"width":1,"depth":6,"dep_dip_plunge":null,"dep_dip_dir":null,"strike":135,"work_desc":"Underground workings, and shafts","dep_shape":null,"structure":"sh