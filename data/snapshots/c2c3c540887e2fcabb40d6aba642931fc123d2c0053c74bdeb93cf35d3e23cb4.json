0637],[143.667774363,-14.981810725],[143.667774729,-14.99847738],[143.651108274,-14.998477468],[143.634441819,-14.998477556],[143.617775365,-14.998477633],[143.617775464,-15.015144333],[143.601109009,-15.01514441],[143.58444241,-15.015144564],[143.5677758,-15.015144719],[143.551109201,-15.015144873],[143.551109322,-15.031811551],[143.534442723,-15.031811706],[143.517776135,-15.03181186],[143.501109536,-15.031812004]],[[143.601109668,-15.131811244],[143.584443125,-15.131811387],[143.584443026,-15.115144698],[143.601109569,-15.115144555],[143.601109668,-15.131811244]]]}", "author": null, "author_email": null, "commodity": ["http://linked.data.gov.au/def/geo-commodities/gold", "http://linked.data.gov.au/def/geo-commodities/monazite", "http://linked.data.gov.au/def/geo-commodities/xenotime-gemstone", "http://linked.data.gov.au/def/geo-commodities/zircon"], "creator": "geological-survey-of-queensland", "creator_user_id": "53d1baf7-cd1a-4ba3-a007-ed1195c24610", "dataset_completion_date": "1988-09-01", "dataset_start_date": "1988-09-01", "earth_science_data_category": [], "extra:access_rights": "http://linked.data.gov.au/def/data-access-rights/open", "extra:contact_uri": "GSQOpenData@resources.qld.gov.au", "extra:identifier": "CR017878", "georesource_report_type": "http://linked.data.gov.au/def/georesource-report/permit-report-partial-relinquishment", "id": "015c449c-6fda-41ea-b597-c71513cf0276", "isopen": true, "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": null, "maintainer_email": null, "metadata_created": "2020-08-02T06:39:02.569667", "metadata_modified": "2026-07-07T21:16:08.491501", "name": "cr017878", "notes": "EPM 5008, MOREHEAD RIVER, PARTIAL RELINQUISHMENT REPORT FOR PERIOD 27/10/1987 TO 22/12/1987", "num_resources": 11, "num_tags": 1, "open_file_date": "1988-09-01", "organization": {"id": "1461ac2d-f813-4c97-9e3b-3900a23b0ecb", "name": "geological-survey-of-queensland", "title": "Geological Survey of Queensland", "type": "organization", "description": "GSQ unlocks the value of geoscience data to enable industry success.\r\n\r\nGSQ plays a key role in improving understanding of Queensland's resource potential and attracting exploration and investment in the resources sector.\r\n\r\n#Exploration attraction\r\nGSQ creates and distributes exploration and resource investment information and presents at national and international events. We also raise awareness of Queensland's prospectivity through new geoscientific information and manage industry exploration grants.\r\n\r\n#Mineral and energy geoscience\r\nGSQ collects and provides geoscience data, information and advice on Queensland\u2019s mineral resources and resource potential through a range of [geoscience projects and initiatives](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/geoscience-projects).\r\n\r\nWe support the state\u2019s energy industry by collecting and providing geoscience data and advice on coal, coal seam gas, petroleum, including unconventional petroleum, oil shale and geothermal energy.\r\n\r\n#Geoscience products and services\r\nWe make mineral and energy geoscience data and information available to industry and government through our publications, maps and digital data products.\r\n\r\nThe Exploration Data Centre (EDC) at Brisbane and the John Campbell Miles Drill Core Storage Facility at Mount Isa house geoscience data and information dating back to the mid-1800s. The collections include [drill core and cuttings](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/exploration-incentives/drillcore) from the Department of Natural Resources, Mines and Energy (DNRME) and company exploration programs, and samples from GSQ mapping fieldwork. The EDC also provides [HyLoggerTM scanning services](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/exploration-incentives/drillcore).\r\n\r\n#Online services\r\nOnline access is available for many of our products, through [MinesOnlineMaps](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/minesonlinemaps), [QDEX Reports](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/qdex-reports), [QDEX Data](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/qdex-data) and [QSpatial](https://www.business.qld.gov.au/running-business/support-assistance/mapping-data-imagery/data/qspatial).", "image_url": "", "created": "2019-05-13T06:53:09.682491", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner": "ASTRIK RESOURCES N. L.", "owner_org": "1461ac2d-f813-4c97-9e3b-3900a23b0ecb", "private": false, "resource_authority_permit": "EPM 5008", "spatial": "{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:7844\"}},\"coordinates\":[[[143.501109536,-15.215144734],[143.501109536,-14.93181012],[143.78443897,-14.93181012],[143.78443897,-15.215144734],[143.501109536,-15.215144734]]]}", "state": "active", "syndicate": "True", "title": "EPM 5008, MOREHEAD RIVER, PARTIAL RELINQUISHMENT REPORT FOR PERIOD 27/10/1987 TO 22/12/1987", "type": "report", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2020-08-02T06:39:02.574509", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "", "download_url": "https://geoscience.data.qld.gov.au/data/dataset/015c449c-6fda-41ea-b597-c71513cf0276/resource/geo-doc386621-cr017878/download/%252FReport%25252f17878%25252fDocument%25252f386621%25252f17878.zip", "format": "ZIP", "hash": "", "id": "geo-doc386621-cr017878", "last_modified": null, "metadata_modified": "2026-05-26T16:24:16.007526", "mimetype": null, "mimetype_inner": 