26678],[140.401171285,-21.515160018],[140.401171016,-21.498493359],[140.401170748,-21.481826699],[140.417837338,-21.48182651],[140.434503928,-21.481826322]]],[[[140.351170431,-21.448493952],[140.351170705,-21.465160609],[140.367837296,-21.465160419],[140.367837568,-21.481827077],[140.351170978,-21.481827266],[140.334504388,-21.481827454],[140.317837798,-21.481827643],[140.317837521,-21.465160988],[140.334504113,-21.465160799],[140.334503838,-21.448494142],[140.334503679,-21.431827544],[140.351170269,-21.431827352],[140.351170431,-21.448493952]]],[[[140.417834553,-21.265160433],[140.401168003,-21.265160637],[140.401167675,-21.248493976],[140.417834218,-21.248493769],[140.417834553,-21.265160433]]]]}", "author": null, "author_email": null, "commodity": ["http://linked.data.gov.au/def/geo-commodities/copper", "http://linked.data.gov.au/def/geo-commodities/gold", "http://linked.data.gov.au/def/geo-commodities/lead", "http://linked.data.gov.au/def/geo-commodities/phosphorous", "http://linked.data.gov.au/def/geo-commodities/silver", "http://linked.data.gov.au/def/geo-commodities/zinc"], "creator": "geological-survey-of-queensland", "creator_user_id": "53d1baf7-cd1a-4ba3-a007-ed1195c24610", "dataset_completion_date": "2026-03-05", "dataset_start_date": "2012-10-22", "earth_science_data_category": ["http://linked.data.gov.au/def/earth-science-data-category/geochemistry"], "extra:access_rights": "http://linked.data.gov.au/def/data-access-rights/open", "extra:contact_uri": "GSQOpenData@resources.qld.gov.au", "extra:identifier": "CR166873", "georesource_report_type": "http://linked.data.gov.au/def/georesource-report/permit-report-partial-relinquishment", "id": "004bfec1-c987-4a23-8aa7-12f23e96dd76", "isopen": true, "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": null, "maintainer_email": null, "metadata_created": "2026-09-07T04:38:44.856473", "metadata_modified": "2026-09-07T04:38:44.856478", "name": "cr166873", "notes": "EPM 19022 Frogmouth project is being explored for various mineralisation including Proterozoic iron-oxide copper-gold, oxide copper, gold only and Pb-Zn styles of mineralisation, as well as Cambrian phosphate within the Georgina Basin. A regional stream sediment survey as part of the Queensland Government Round 5 Collaborative Exploration Initiative funding was completed by Chinova from 2021 to 2022.  A total of 2548 samples have been taken at 1274 sample locations and analysed for a full multielement suite, including rare earth elements and Bulk Leach Extraction Gold.  \nDue to a recent strategic focus on more advanced prospects considered to offer greater potential, 4 subblocks were relinquished 5 March 2026.  \nWork on 4 relinquished subblocks CLON 1541 A, CLON 1541 F, CLON 1541 L and CLON 1541 R has been limited to desktop technical evaluation for target generation.  No exploration targets were generated in the subblocks relinquished.", "num_resources": 2, "num_tags": 1, "open_file_date": "2026-09-07", "organization": {"id": "1461ac2d-f813-4c97-9e3b-3900a23b0ecb", "name": "geological-survey-of-queensland", "title": "Geological Survey of Queensland", "type": "organization", "description": "GSQ unlocks the value of geoscience data to enable industry success.\r\n\r\nGSQ plays a key role in improving understanding of Queensland's resource potential and attracting exploration and investment in the resources sector.\r\n\r\n#Exploration attraction\r\nGSQ creates and distributes exploration and resource investment information and presents at national and international events. We also raise awareness of Queensland's prospectivity through new geoscientific information and manage industry exploration grants.\r\n\r\n#Mineral and energy geoscience\r\nGSQ collects and provides geoscience data, information and advice on Queensland\u2019s mineral resources and resource potential through a range of [geoscience projects and initiatives](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/geoscience-projects).\r\n\r\nWe support the state\u2019s energy industry by collecting and providing geoscience data and advice on coal, coal seam gas, petroleum, including unconventional petroleum, oil shale and geothermal energy.\r\n\r\n#Geoscience products and services\r\nWe make mineral and energy geoscience data and information available to industry and government through our publications, maps and digital data products.\r\n\r\nThe Exploration Data Centre (EDC) at Brisbane and the John Campbell Miles Drill Core Storage Facility at Mount Isa house geoscience data and information dating back to the mid-1800s. The collections include [drill core and cuttings](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/exploration-incentives/drillcore) from the Department of Natural Resources, Mines and Energy (DNRME) and company exploration programs, and samples from GSQ mapping fieldwork. The EDC also provides [HyLoggerTM scanning services](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/exploration-incentives/drillcore).\r\n\r\n#Online services\r\nOnline access is available for many of our products, through [MinesOnlineMaps](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/minesonlinemaps), [QDEX Reports](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/qdex-reports), [QDEX Data](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/qdex-data) and [QSpatial](https://www.business.qld.gov.au/running-business/support-assistance/mapping-data-imagery/data/qspatial).", "image_url": "", "created": "2019-05-13T06:53:09.682491", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner": "CHINOVA RESOURCES CLONCURRY MINES PTY LTD", "owner_org": "1461ac2d-f813-4c97-9e3b-3900a23b0ecb", "private": false, "resource_authority_permit": "EPM 19022", "spatial": "{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:7844\"}},\"coordinates\":[[[140.167839202,-21.881825855],[140.167839202,-21.248493769],[140.53450508,-21.248493769],[140.53450508,-21.881825855],[140.167839202,-21.881825855]]]}", "state": "active", "syndicate": "True", "title": "EPM19022 FROGMOUTH PARTIAL RELINQUISHMENT REPORT FOR PERIOD ENDING 05 MARCH 2026", "type": "report", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2026-09-07T04:38:44.862945", "datastore_active": false, "description": null, "format": "PDF", "hash": "", "id": "geo-doc1432078-cr166873", "last_modified": null, "metadata_modified": "2026-09-07T04:38:44.850599", "mimetype": null, "mimetype_inner": null, "name": "EPM 19022 Frogmouth Partial Relinquishment Report for 4 subblocks relinquished 5 March 2026.", "package_id": "004bfec1-c987-4a23-8aa7-12f23e96dd76", "position": 0, "resource:access_rights": "http://linked.data.gov.au/def/data-access-rights/open", "resource:description": "Report Body", "resource:format": "PDF", "resource:resource_type": "ASSOCIATED_DOCUMENT", "resource:size": "2.67 MB", "resource_type": null, "size": null, "state": "active", "url": "https://gsq-prod-ckan-horizon-public.s3.ap-southeast-2.amazonaws.com/Report%2f166873%2fDocument%2f1432078%2fEPM19022+Partial+Relinquishment+Report+2026.pdf", "url_type": null, "download_url": "https://geoscience.data.qld.gov.au/data/dataset/004bfec1-c987-4a23-8aa7-12f23e96dd76/resource/geo-doc1432078-cr166873/download/%252FReport%25252f166873%25252fDocument%25252f1432078%25252fEPM19022%252BPartial%252BRelinquishment%252BReport%252B2026.pdf"}, {"cache_last_updated": null, "cache_url": null, "created": "2026-09-07T04:38:44.862949", "datastore_active": false, "description": null, "format": "TXT", "hash": "", "id": "ge