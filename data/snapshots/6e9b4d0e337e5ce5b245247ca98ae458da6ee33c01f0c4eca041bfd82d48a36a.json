{"help": "https://geoscience.data.qld.gov.au/data/api/3/action/help_show?name=package_show", "success": true, "result": {"GeoJSONextent": "{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:7844\"}},\"coordinates\":[[[153.351058111,-26.94839858],[153.351058269,-26.96506546],[153.351058427,-26.98173234],[153.351058586,-26.99839922],[153.351058728,-27.015066026],[153.35105887,-27.031732834],[153.351059013,-27.048399644],[153.367725364,-27.04839921],[153.36772522,-27.031732425],[153.384391572,-27.031732011],[153.384391427,-27.015065195],[153.40105778,-27.015064751],[153.417724134,-27.015064306],[153.41772399,-26.998397478],[153.401057637,-26.998397924],[153.401057476,-26.981731132],[153.384391127,-26.981731535],[153.384390978,-26.965064712],[153.367724623,-26.965065086],[153.367724469,-26.948398235],[153.351058111,-26.94839858]]]}", "author": null, "author_email": null, "commodity": ["http://linked.data.gov.au/def/geo-commodities/ilmenite", "http://linked.data.gov.au/def/geo-commodities/monazite", "http://linked.data.gov.au/def/geo-commodities/rutile", "http://linked.data.gov.au/def/geo-commodities/zircon"], "creator": "geological-survey-of-queensland", "creator_user_id": "53d1baf7-cd1a-4ba3-a007-ed1195c24610", "dataset_completion_date": "1987-12-01", "dataset_start_date": "1987-12-01", "earth_science_data_category": [], "extra:access_rights": "http://linked.data.gov.au/def/data-access-rights/open", "extra:contact_uri": "GSQOpenData@resources.qld.gov.au", "extra:identifier": "CR017345", "georesource_report_type": "http://linked.data.gov.au/def/georesource-report/permit-report-six-month", "id": "022e0600-2d02-48b6-a07e-e3800a501eb7", "isopen": true, "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": null, "maintainer_email": null, "metadata_created": "2020-08-08T15:45:27.850204", "metadata_modified": "2026-07-28T10:01:19.034931", "name": "cr017345", "notes": "EPM 4655, SIX MONTHLY REPORT FOR PERIOD ENDING 23/9/1987", "num_resources": 7, "num_tags": 1, "open_file_date": "1987-12-01", "organization": {"id": "1461ac2d-f813-4c97-9e3b-3900a23b0ecb", "name": "geological-survey-of-queensland", "title": "Geological Survey of Queensland", "type": "organization", "description": "GSQ unlocks the value of geoscience data to enable industry success.\r\n\r\nGSQ plays a key role in improving understanding of Queensland's resource potential and attracting exploration and investment in the resources sector.\r\n\r\n#Exploration attraction\r\nGSQ creates and distributes exploration and resource investment information and presents at national and international events. We also raise awareness of Queensland's prospectivity through new geoscientific information and manage industry exploration grants.\r\n\r\n#Mineral and energy geoscience\r\nGSQ collects and provides geoscience data, information and advice on Queensland\u2019s mineral resources and resource potential through a range of [geoscience projects and initiatives](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/geoscience-projects).\r\n\r\nWe support the state\u2019s energy industry by collecting and providing geoscience data and advice on coal, coal seam gas, petroleum, including unconventional petroleum, oil shale and geothermal energy.\r\n\r\n#Geoscience products and services\r\nWe make mineral and energy geoscience data and information available to industry and government through our publications, maps and digital data products.\r\n\r\nThe Exploration Data Centre (EDC) at Brisbane and the John Campbell Miles Drill Core Storage Facility at Mount Isa house geoscience data and information dating back to the mid-1800s. The collections include [drill core and cuttings](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/exploration-incentives/drillcore) from the Department of Natural Resources, Mines and Energy (DNRME) and company exploration programs, and samples from GSQ mapping fieldwork. The EDC also provides [HyLoggerTM scanning services](https://www.business.qld.gov.au/industries/mining-energy-water/resources/geoscience-information/exploration-incentives/drillcore).\r\n\r\n#Online services\r\nOnline access is available for many of our products, through [MinesOnlineMaps](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/minesonlinemaps), [QDEX Reports](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/qdex-reports), [QDEX Data](https://www.business.qld.gov.au/industries/mining-energy-water/resources/minerals-coal/online-services/qdex-data) and [QSpatial](https://www.business.qld.gov.au/running-business/support-assistance/mapping-data-imagery/data/qspatial).", "image_url": "", "created": "2019-05-13T06:53:09.682491", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner": "DENISON RESOURCES N. L.", "owner_org": "1461ac2d-f813-4c97-9e3b-3900a23b0ecb", "private": false, "resource_authority_permit": "EPM 4655", "spatial": "{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:7844\"}},\"coordinates\":[[[153.351058111,-27.048399644],[153.351058111,-26.948398235],[153.417724134,-26.948398235],[153.417724134,-27.048399644],[153.351058111,-27.048399644]]]}", "state": "active", "syndicate": "True", "title": "EPM 4655, SIX MONTHLY REPORT FOR PERIOD ENDING 23/9/1987", "type": "report", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2020-08-08T15:45:27.876189", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "", "download_url": "https://geoscience.data.qld.gov.au/data/dataset/022e0600-2d02-48b6-a07e-e3800a501eb7/resource/geo-doc1106145-cr017345/download/%252FReport%25252f17345%25252fD