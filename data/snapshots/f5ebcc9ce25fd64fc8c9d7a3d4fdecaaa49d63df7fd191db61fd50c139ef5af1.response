ence, a ferruginous siltstone unit of the Baledmund Formation, as at Boppy Blocks mine. Strike of conglomerate 165 deg, dip 50 deg W.","size_code":"OCC","major_comm":"Au","minor_comm":"Fe, Mn","ore_min":"limonite, pyrolusite (pyrite)","gangue_min":"host","hostrocks":null,"reference":"Dowmill Pty Ltd &  Gold Fields Exploration Pty Ltd (1988) GS1988/009;  Dowmill Pty Ltd, Gold Fields Exploration Pty Ltd (1989) GS1984/035c;  Gilligan L.B. &  Byrnes J.G. (1995a) ;  Gilligan L.B. & Byrnes J.G. (1995) ","compiler":"LB Gilligan & JG Byrnes, Nov 1986","production":null,"resources":null,"gs_number":"GS1984/035c, GS1988/009","colour":"red","is_metmin_resource":"n"},"bbox":[146.2859,-31.5422,146.2859,-31.5422]},{"type":"Feature","id":"mineral_occurrence.101778","geometry":{"type":"Point","coordinates":[146.2848,-31.5503]},"geometry_name":"geom","properties":{"occurrence_id":101778,"deposit_name":"Boppy Blocks","comm_type":"METMIN","field_no":null,"metal_no":"CO0156","old_no":"CO0156","metal_dist":"Canbelego","all_names":"Boppy Blocks","latgda94":-31.55032,"longda94":146.284765,"ll_coordsys":"GDA94","loc_method":"250K","accuracy":250,"grid_loc":null,"mga_north":6509184,"mga_east":432114,"mga_coordsys":"MGA_55S","length":null,"width":null,"depth":60,"dep_dip_plunge":null,"dep_dip_dir":null,"strike":null,"work_desc":"undrground workings, shafts, shallow pits","dep_shape":null,"structure":null,"host_relate":"stratabound","msn_style":null,"ore_texture":null,"alteration":"silicic","placer":null,"spec_model":null,"gen_model":null,"cox_class":null,"other_class":"residual Fe-Mn","nsw_class":"Structurally controlled low sulfide Au","nsw_gen":"Hydrothermal metamorphic Au","summary_desc":"A wide belt of gossan outcrops strongly at Boppy Blocks. From the Boppy Blocks shafts, trending 115 deg t for a length of 400m. Additional indications of mineralization include two other shafts and an assay value of 2650 ppm Sb.","size_code":"OCC","major_comm":"Fe, Mn","minor_comm":"Au, Pb, Zn","ore_min"