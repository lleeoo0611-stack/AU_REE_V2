2","metal_dist":"Gulgong","all_names":"Puggoon,Puggoon South Prospects","latgda94":-32.30219,"longda94":149.472076,"ll_coordsys":"GDA94","loc_method":"50K","accuracy":100,"grid_loc":null,"mga_north":6423384,"mga_east":732763,"mga_coordsys":"MGA_55S","length":null,"width":null,"depth":18,"dep_dip_plunge":90,"dep_dip_dir":295,"strike":25,"work_desc":null,"dep_shape":null,"structure":"shear","host_relate":"intrusive contact","msn_style":"massive","ore_texture":"radiating","alteration":null,"placer":null,"spec_model":"skarn","gen_model":"hydrothermal","cox_class":null,"other_class":"skarn Fe","nsw_class":"Granite-related Fe skarn","nsw_gen":"Granite","summary_desc":"The mineralisation consists of two small magnetite bodies separated by about 150m. Each zone is approximatly 61m long, The Puggoon zone is 23m wide while Puggoon South zone appears narrower - approx 9m wide.","size_code":"OCC","major_comm":"Iron oxides - magnetite, Fe","minor_comm":null,"ore_min":"haematite, limonite, magnetite","gangue_min":"host","hostrocks":"gabbro - Gulgong Granite;  hornfels - Dungeree Volcanics;  schist - Dungeree Volcanics;  slate - Dungeree Volcanics","reference":"(1985) GS1985/272;  CRA Exploration Pty Ltd (1992ak) GS1993/056;  Dabserv Corporate Service Pty Ltd, Eagle Corporation Pty Ltd (1987) GS1985/278;  Matson C.R. (1975) GS1975/139;  Matson C.R. (1974c) ;  Matson C.R. (1975a) ;  Rayner E.O. (1953a) GS1953/012","compiler":"CR Matson 28/06/1971","production":null,"resources":null,"gs_number":"GS1953/012, GS1975/139, GS1985/272, GS1985/278, GS1993/056","colour":"maroon","is_metmin_resource":"n"},"bbox":[149.4721,-32.3022,149.4721,-32.3022]},{"type":"Feature","id":"mineral_occurrence.103248","geometry":{"type":"Point","coordinates":[149.4606,-32.3687]},"geometry_name":"geom","properties":{"occurrence_id":103248,"deposit_name":"Digger Prince","comm_type":"METMIN","field_no":"CB0052","metal_no":"DU0087","old_no":"DU0053","metal_dist":"Cudgegong River","all_names":"Digger Prince","lat