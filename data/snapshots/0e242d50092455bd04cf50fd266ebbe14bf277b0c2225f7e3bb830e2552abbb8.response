:null,"spec_model":"vein","gen_model":"hydrothermal","cox_class":null,"other_class":"orogenic Au","nsw_class":"Structurally controlled low sulfide Au","nsw_gen":"Hydrothermal metamorphic Au","summary_desc":"Mineralization at the Red Hill Mine occurs in a diorite that has intruded the Burranah Formation. The diorite does not outcrop at the minesite but Jones (1940) describes \"highly altered claystones which have been intruded by dykes and masses of diorite\".","size_code":"OCC","major_comm":"Au","minor_comm":null,"ore_min":"gold","gangue_min":"quartz","hostrocks":"claystone - Burranah Formation;  diorite - Burranah Formation","reference":"Matson C.R. (1974c) ;  Matson C.R. (1975a) ","compiler":"CR Matson 27/08/1971","production":null,"resources":null,"gs_number":null,"colour":"red","is_metmin_resource":"n"},"bbox":[149.5349,-32.3648,149.5349,-32.3648]},{"type":"Feature","id":"mineral_occurrence.103261","geometry":{"type":"Point","coordinates":[149.5325,-32.4883]},"geometry_name":"geom","properties":{"occurrence_id":103261,"deposit_name":"Royal George Mine","comm_type":"METMIN","field_no":"GU0076","metal_no":"DU0237","old_no":"DU0066","metal_dist":"Gulgong","all_names":"Royal George Mine","latgda94":-32.48833,"longda94":149.53248,"ll_coordsys":"GDA94","loc_method":"25K","accuracy":50,"grid_loc":"Location of main shaft.","mga_north":6402609,"mga_east":737963,"mga_coordsys":"MGA_55S","length":240,"width":150,"depth":52,"dep_dip_plunge":50,"dep_dip_dir":150,"strike":60,"work_desc":"Main workings along central quartz vein-5 shafts. Other workings N and S. 180m adit to S in creek strikes 320 and meets shaft 150m S of main workings.","dep_shape":null,"structure":null,"host_relate":null,"msn_style":"vein, disseminated","ore_texture":"cataclastic","alteration":null,"placer":null,"spec_model":"vein","gen_model":"hydrothermal","cox_class":null,"other_class":"orogenic Au","nsw_class":"Structurally controlled low sulfide Au","nsw_gen":"Hydrothermal metamorphic Au","summary_desc":"The veins at the Royal George are developed perpendicular to the regional cleavage (330) and essentially parallel to the maximum principle stress (NE-SW). The deposit had several high grade shoots that contained from 92-122 g/t Au.","size_code":"OCC","major_comm":"Au","minor_comm":null,"ore_min":"arsenopyrite, chalcopyrite, galena, gold, pyrite, sphalerite","gangue_min":"quartz","hostrocks":"rhyodacite - Dungeree Volcanics","reference":"(1988) GS1988/010;  Matson C.R. (1974c) ;  Matson C.R. (1975a) ","compiler":"CR Matson 27/08/1971","production":null,"resources":null,"gs_number":"GS1988/010","colour":"red","is_metmin_resource":"n"},"bbox":[149.5325,-32.4883,149.5325,-32.4883]},{"type":"Feature","id":"mineral_occurrence.103262","geometry":{"type":"Point","coordinates":[149.5525,-32.2931]},"geometry_name":"geom","properties":{"occurrence_id":103262,"deposit_name":"Maxwells Clay","comm_type":"CLAYS","field_no":"GU0034","metal_no":"DU0128","old_no":"DU0067","metal_dist":"Gulgong","all_names":"Maxwells Clay, Maxwells No.1 Clay Pit; Wyaldra Creek - Gum Creek Kaolin","latgda94":-32.293149,"longda94":149.552516,"ll_coordsys":"GDA94","loc_method":"25K","accuracy":50,"grid_loc":"centre of deposit","mga_north":6424209,"mga_east":740363,"mga_coordsys":"MGA_55S","length":null,"width":null,"depth":null,"dep_dip_plunge":null,"dep_dip_dir":null,"strike":null,"work_desc":null,"dep_shape":null,"structure":null,"host_relate":null,"msn_style":null,"ore_texture":null,"alteration":null,"placer":null,"spec_model":null,"gen_model":null,"cox_class":null,"other_class":"industrial - clay","nsw_class":"Kaolinite","nsw_gen":"Residual","summary_desc":"Production from Maxwells clay deposit is reported as  INDMIN site 6072. Location 21 in Baker and Uren (1982) p 89.","size_code":"SML","major_comm":"kaolin - refractory, clay/shale - structural","minor_comm":null,"ore_min":null,"gangue_min":null,"hostrocks":"clay - Ungrouped Cenozoic sedimentary units","reference":"Baker C.J., Uren R.E. (1982) ; 