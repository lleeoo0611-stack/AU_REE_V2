t","comm_type":"METMIN","field_no":"MU0124","metal_no":"DU0624","old_no":null,"metal_dist":"Accost-Dead Horse","all_names":"Accost Prospect","latgda94":-32.652526,"longda94":149.763592,"ll_coordsys":"GDA94","loc_method":"25K","accuracy":50,"grid_loc":"Centre of costean or trench.","mga_north":6383858,"mga_east":759213,"mga_coordsys":"MGA_55S","length":500,"width":null,"depth":null,"dep_dip_plunge":null,"dep_dip_dir":null,"strike":null,"work_desc":"4 costeans up to 175m long, in an area about 500mx300m. Area orientated N.W.","dep_shape":null,"structure":null,"host_relate":null,"msn_style":"disseminated, vein","ore_texture":null,"alteration":"sericitic, chloritic, silicic","placer":null,"spec_model":"kuroko","gen_model":"exhalative","cox_class":"Volcanogenic massive sulphide","other_class":"VHMS-Kuroko","nsw_class":"Siliciclastic-felsic-hosted Zn-Pb-Cu-(Ag-Au-Sn)/barite","nsw_gen":"Volcanic-associated massive sulfide","summary_desc":"The mineralization consists of \" blebs\" of sphalerite, pyrite, and minor chalcopyrite. Galena most evident in quartz-carbonate veinlets with some sphalerite. The \"Sodic\" rhyolites appear to be more mineralized than the \"potassic\" altered rocks.","size_code":"OCC","major_comm":"Zn, Pb","minor_comm":"Cu","ore_min":"galena, pyrite, sphalerite (chalcopyrite)","gangue_min":"carbonate, host, quartz","hostrocks":"rhyolite - Dungeree Volcanics;  tuff - Dungeree Volcanics","reference":"(1980) GS1980/318;   (1977) GS1977/178","compiler":"Paul Murrell 1995","production":null,"resources":null,"gs_number":"GS1977/178, GS1980/318","colour":"red","is_metmin_resource":"n"},"bbox":[149.7636,-32.6525,149.7636,-32.6525]},{"type":"Feature","id":"mineral_occurrence.103066","geometry":{"type":"Point","coordinates":[149.7756,-32.6345]},"geometry_name":"geom","properties":{"occurrence_id":103066,"deposit_name":"Hayes Prospect","comm_type":"METMIN","field_no":"MU0132","metal_no":"DU0632","old_no":null,"metal_dist":"Accost-Dead Horse","all_names":"Hayes Prospect","latgda94":-32.634454,"longda94":149.775557,"ll_coordsys":"GDA94","loc_method":"25K","accuracy":50,"grid_loc":"A shallow pit.","mga_north":6385834,"mga_east":760388,"mga_coordsys":"MGA_55S","length":null,"width":null,"depth":null,"dep_dip_plunge":null,"dep_dip_dir":null,"strike":null,"work_desc":"One shallow pit.","dep_shape":null,"structure":null,"host_relate":null,"msn_style":"disseminated, vein","ore_texture":null,"alteration":"sericitic, chloritic, silicic","placer":null,"spec_model":"kuroko","gen_model":"exhalative","cox_class":"Volcanogenic massive sulphide","other_class":"VHMS-Kuroko","nsw_class":"Siliciclastic-felsic-hosted Zn-Pb-Cu-(Ag-Au-Sn)/barite","nsw_gen":"Volcanic-associated massive sulfide","summary_desc":"A number of stages have been recognised, initially pyrite and pyrrhotite deposited throughout host rock. Recrystallisation and remobilization has resulted in sphalerite being deposited in fine quartz veinlets, and later, quartz-chalcopyrite-pyrite veins.","size_code":"OCC","major_comm":"Cu, Pb, Zn","minor_comm":null,"ore_min":"chalcopyrite, galena, pyrite, pyrrhotite, sphalerite","gangue_min":"carbonate, host, quartz","hostrocks":"andesite - Dungeree Volcanics;  chert - Dungeree Volcanics;  rhyolite - Dungeree Volcanics;  tuff - Dungeree Volcanics","reference":"(1980) GS1980/318;   (1977) GS1977/178","compiler":"Paul Murrell 1995","production":null,"resources":null,"gs_number":"GS1977/178, GS1980/318","colour":"red","is_metmin_resource":"n"},"bbox":[149.7756,-32.6345,149.7756,-32.6345]},{"type":"Feature","id":"mineral_occurrence.103067","geometry":{"type":"Point","coordinates":[149.7743,-32.6449]},"geometry_name":"geom","properties":{"occurrence_id":103067,"deposit_name":"Dead Horse Shafts","comm_type":"METMIN","field_no":"MU0130","metal_no":"DU0630","old_no":null,"metal_dist":"not assigned","all_names":"Dead Horse Shafts","latgda94":-32.644851,"longda94":149.77428,"ll_coordsys":"GDA94","loc_method":"25K","accuracy":50,"grid_loc":"Centre of g