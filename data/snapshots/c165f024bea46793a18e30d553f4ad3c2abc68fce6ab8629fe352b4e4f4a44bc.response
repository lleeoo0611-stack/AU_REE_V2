oduction for  0.000459t Ag, 0.024882t Au  ","resources":null,"gs_number":"GS1968/349, GS1980/447, GS1982/586, GS1985/181","colour":"red","is_metmin_resource":"n"},"bbox":[149.1332,-32.5234,149.1332,-32.5234]},{"type":"Feature","id":"mineral_occurrence.102611","geometry":{"type":"Point","coordinates":[149.1378,-32.5229]},"geometry_name":"geom","properties":{"occurrence_id":102611,"deposit_name":"Lauts Mine","comm_type":"METMIN","field_no":"EU0028","metal_no":"DU0351","old_no":null,"metal_dist":"Federal","all_names":"Lauts Mine","latgda94":-32.522936,"longda94":149.13781,"ll_coordsys":"GDA94","loc_method":"50K","accuracy":100,"grid_loc":"Centre of worked area","mga_north":6399584,"mga_east":700793,"mga_coordsys":"MGA_55S","length":null,"width":0.15,"depth":10,"dep_dip_plunge":null,"dep_dip_dir":105,"strike":195,"work_desc":"Shallow surface workings.","dep_shape":null,"structure":null,"host_relate":null,"msn_style":"vein, disseminated","ore_texture":null,"alteration":null,"placer":null,"spec_model":"vein","gen_model":"hydrothermal","cox_class":null,"other_class":"Vein Au","nsw_class":"Structurally controlled low sulfide Au","nsw_gen":"Hydrothermal metamorphic Au","summary_desc":"These workings consist of shallow pits adjacent to Federal Mine. The mineralisation consists of narrow auriferous quartz, calcite, pyrite vein(s) with trace chalcopyrite. The veins trend 015 and dip east in andesite.","size_code":"SML","major_comm":"Au","minor_comm":null,"ore_min":"gold, pyrite","gangue_min":"calcite, quartz","hostrocks":"andesite - Crudine Group","reference":"() MR01127;  Amax Exploration (Aust) Inc (1971) GS1971/538","compiler":"JT Pienmunne 1995","production":":0t estimated production for  0.001176t Au  ","resources":null,"gs_number":"GS1971/538, MR01127","colour":"red","is_metmin_resource":"n"},"bbox":[149.1378,-32.5229,149.1378,-32.5229]},{"type":"Feature","id":"mineral_occurrence.102612","geometry":{"type":"Point","coordinates":[149.1369,-32.5198]},"geometry_name":"geom",