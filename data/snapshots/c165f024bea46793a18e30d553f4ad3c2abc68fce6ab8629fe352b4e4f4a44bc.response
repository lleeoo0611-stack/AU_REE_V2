ered adesitic lava. The shaft is 30m deep.","size_code":"OCC","major_comm":"Au","minor_comm":"Cu","ore_min":"gold, limonite, malachite, pyrite","gangue_min":"host, quartz","hostrocks":"andesite - Cuga Burga Volcanics","reference":"(1977) GS1977/145;  Matson C.R. (1974c) ;  Matson C.R. (1975a) ","compiler":"Yvonne Sanders, JT Pienmunne 1995","production":null,"resources":null,"gs_number":"GS1977/145","colour":"red","is_metmin_resource":"n"},"bbox":[148.8718,-32.7504,148.8718,-32.7504]},{"type":"Feature","id":"mineral_occurrence.102946","geometry":{"type":"Point","coordinates":[148.9831,-32.5922]},"geometry_name":"geom","properties":{"occurrence_id":102946,"deposit_name":"Lady Macquarie Dredge","comm_type":"METMIN","field_no":"WE0028","metal_no":"DU0323","old_no":"DU0100,DU0111","metal_dist":"Macquarrie River","all_names":"Lady Macquarie Dredge, Wellington Alluvials NL, Harveys Freehold Dredging Company.","latgda94":-32.59221,"longda94":148.983066,"ll_coordsys":"GDA94","loc_method":"50K","accuracy":100,"grid_loc":"Centre of dredged area","mga_north":6392184,"mga_east":686113,"mga_coordsys":"MGA_55S","length":12000,"width":100,"depth":30,"dep_dip_plunge":null,"dep_dip_dir":null,"strike":null,"work_desc":"Dredging and sluicing along a 12km stretch of Macquarie River.","dep_shape":"irregular","structure":null,"host_relate":"stratabound","msn_style":"disseminated","ore_texture":null,"alteration":null,"placer":null,"spec_model":"fossil placer (fluvial)","gen_model":"mechanical","cox_class":null,"other_class":"placer - Au-diamond","nsw_class":"Au-Ag eluvial/alluvial/deep lead","nsw_gen":"Mechanical","summary_desc":"This site refers to a 12km stretch of Macquarie River that was dredged and sluiced for alluvial gold located in recent alluvium and Tertiary deep leads. The gold was origionally derived from older deep leads and reef deposits in the viscinity.","size_code":"MED","major_comm":"Au","minor_comm":"diamond - gem","ore_min":"gold (diamond)","gangue_min":null,"hostrocks